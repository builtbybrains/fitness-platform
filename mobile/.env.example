# Stripe publishable key (safe to ship in the client).
# The SECRET key must never appear here or anywhere in this app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Your backend, which creates the subscription and returns a PaymentIntent
# client secret. Without this the app runs the subscription flow in demo mode.
EXPO_PUBLIC_API_URL=https://api.vital.app

# OpenRouter key for the live AI coach (https://openrouter.ai/keys).
# EXPO_PUBLIC_ values are embedded in the app bundle; use a backend proxy
# before a public release.
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-xxx
# Optional: override the model (default stealth/ox-alpha).
EXPO_PUBLIC_AI_MODEL=stealth/ox-alpha
