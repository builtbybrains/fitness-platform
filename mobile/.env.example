# Stripe publishable key (safe to ship in the client).
# The SECRET key must never appear here or anywhere in this app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Your backend, which creates the subscription and returns a PaymentIntent
# client secret. Without this the app runs the subscription flow in demo mode.
EXPO_PUBLIC_API_URL=https://api.vital.app

# API key for the live AI coach. Accepts an OpenAI key (sk-proj-... or
# sk-...) or an OpenRouter key (sk-or-...); the provider is detected from
# the key. EXPO_PUBLIC_ values are embedded in the app bundle; use a backend
# proxy before a public release.
EXPO_PUBLIC_AI_API_KEY=sk-xxx
# Optional: override the model. Defaults to gpt-4o-mini on an OpenAI key
# and stealth/ox-alpha on an OpenRouter key.
# EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
