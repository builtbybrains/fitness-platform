# Copy to mobile/.env and paste your Supabase project's values.
# Where: Supabase dashboard → Project Settings → API (Data API):
#   "Project URL" and the "anon" / "publishable" key.
# Both are safe to ship in the app: row-level security protects every row,
# and the AI key only ever lives in the Edge Functions.
#
# Leave the placeholders in place to run the app in device-only mode
# (no accounts; data stays on the device).
# After editing, restart with: npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
